              "const r = pm.response.json();",
              "pm.test('net = gross - discounts', () =>",
              "  pm.expect(r.netRevenueCents).to.eql(r.grossRevenueCents - r.totalDiscountsCents));",
              "pm.test('per-product revenue sums to gross', () =>",
              "  pm.expect(r.purchasedQuantityByProduct.reduce((s, p) => s + p.revenueCents, 0))",
              "    .to.eql(r.grossRevenueCents));",
              "pm.test('coupon counts reconcile', () =>",
              "  pm.expect(r.coupons.available + r.coupons.redeemed).to.eql(r.coupons.generated));",
              "pm.test('no negative figures', () => {",
              "  pm.expect(r.grossRevenueCents).to.be.at.least(0);",
              "  pm.expect(r.netRevenueCents).to.be.at.least(0);",
              "});"
            ]
          }
        }
