    {
      "name": "Admin: generate reward coupon",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/admin/coupons/generate",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "admin",
            "coupons",
            "generate"
          ]
        },
        "description": "Administrative. Generates the coupon for the next unrewarded milestone, if enough successful orders have been placed to earn it. One coupon per call; call again to catch up on further milestones.\n\n201 with the coupon when a milestone is due; 409 MILESTONE_NOT_REACHED otherwise \u2014 which is also the answer to a repeat call, since the milestone just rewarded is no longer the next one."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 when a milestone is due, 409 when not', () =>",
              "  pm.expect(pm.response.code).to.be.oneOf([201, 409]));",
              "if (pm.response.code === 201) {",
              "  const coupon = pm.response.json();",
              "  pm.collectionVariables.set('couponCode', coupon.code);",
              "  pm.test('coupon starts AVAILABLE', () => pm.expect(coupon.status).to.eql('AVAILABLE'));",
              "  pm.test('milestone is positive', () => pm.expect(coupon.milestone).to.be.above(0));",
              "  pm.test('carries a discount percentage', () =>",
              "    pm.expect(coupon.discountPercent).to.be.within(1, 100));",
              "} else {",
              "  pm.test('code is MILESTONE_NOT_REACHED', () =>",
              "    pm.expect(pm.response.json().code).to.eql('MILESTONE_NOT_REACHED'));",
              "}"
            ]
          }
        }
      ]
    },
