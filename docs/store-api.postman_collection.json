        "description": "Adds a product to the cart. Run `Create cart` first. Sending the same productId again increases the quantity instead of creating a second row.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"productId\": {{productId}},\n  \"quantity\": 2\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const cart = pm.response.json();",
              "pm.test('cart stays OPEN', () => pm.expect(cart.status).to.eql('OPEN'));",
              "pm.test('item present', () => pm.expect(cart.items.length).to.be.above(0));",
              "pm.test('subtotal matches line totals', () =>",
