    {
      "name": "Checkout cart",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Idempotency-Key",
            "value": "{{idempotencyKey}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/carts/{{cartId}}/checkout",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "carts",
            "{{cartId}}",
            "checkout"
          ]
        },
        "description": "Requires an `Idempotency-Key` header. Turns the OPEN cart into an order in one transaction: stock is taken, prices are snapshotted onto the order lines, and the cart becomes CHECKED_OUT. A fresh key is generated by the pre-request script and stored in `idempotencyKey` so the replay request can reuse it.\n\nThe body is optional. Send `{\"couponCode\": \"...\"}` to redeem a coupon as part of the same transaction."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "const order = pm.response.json();",
              "pm.collectionVariables.set('orderId', order.id);",
              "pm.test('totals reconcile with the lines', () =>",
              "  pm.expect(order.grossTotalCents).to.eql(order.items.reduce((s, i) => s + i.lineTotalCents, 0)));",
              "pm.test('net = gross - discount', () =>",
              "  pm.expect(order.netTotalCents).to.eql(order.grossTotalCents - order.discountTotalCents));"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// A fresh key per real checkout; the replay request reuses this exact value.",
              "pm.collectionVariables.set('idempotencyKey', 'checkout-' + Date.now() + '-' + Math.random().toString(36).slice(2, 8));"
            ]
          }
        }
      ]
    },
    {
      "name": "Checkout with coupon",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Idempotency-Key",
            "value": "{{idempotencyKey}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/carts/{{cartId}}/checkout",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "carts",
            "{{cartId}}",
            "checkout"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"couponCode\": \"{{couponCode}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Redeems the coupon inside the checkout transaction. Set `couponCode` from a generated coupon first. The order records gross, discount and net, plus a copy of the coupon code and percentage so it still explains itself later."
      },
      "response": [],
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('idempotencyKey', 'checkout-' + Date.now() + '-' + Math.random().toString(36).slice(2, 8));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "const order = pm.response.json();",
              "pm.collectionVariables.set('orderId', order.id);",
              "pm.test('discount applied', () => pm.expect(order.discountTotalCents).to.be.above(0));",
              "pm.test('net = gross - discount', () =>",
              "  pm.expect(order.netTotalCents).to.eql(order.grossTotalCents - order.discountTotalCents));",
              "pm.test('net is never negative', () => pm.expect(order.netTotalCents).to.be.at.least(0));",
              "pm.test('coupon snapshotted onto the order', () =>",
              "  pm.expect(order.couponCode).to.eql(pm.collectionVariables.get('couponCode')));",
              "pm.test('discount matches the percentage, rounded half up', () =>",
              "  pm.expect(order.discountTotalCents).to.eql(",
              "    Math.floor((order.grossTotalCents * order.couponDiscountPercent + 50) / 100)));"
            ]
          }
        }
      ]
    },
