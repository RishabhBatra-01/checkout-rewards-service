# Copy to `.env` (git-ignored). These defaults match `docker-compose.yml`, so
# `docker compose up -d` then `./mvnw spring-boot:run` works with no edits.
DB_URL=jdbc:postgresql://localhost:5432/store
DB_USERNAME=store
DB_PASSWORD=store

# --- Using a hosted PostgreSQL such as Supabase instead? --------------------
# Replace the three values above with your own. Two things catch people out:
#
#   * it must be a JDBC URL (jdbc:postgresql://...), not the postgresql://...
#     URI the dashboard shows, and credentials belong in DB_USERNAME /
#     DB_PASSWORD rather than inside the URL;
#   * use the SESSION pooler (port 5432), not the transaction pooler (6543).
#     Flyway takes a session-level advisory lock while migrating and Hibernate
#     uses server-side prepared statements; both misbehave behind a transaction
#     pooler.
#
# DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# DB_USERNAME=postgres.<project-ref>
# DB_PASSWORD=<your-database-password>
