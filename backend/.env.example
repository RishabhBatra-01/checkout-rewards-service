# Copy to `.env` (git-ignored) and fill in your own Supabase values.
#
# In the Supabase dashboard: Project -> Connect -> "Session pooler".
# Use the SESSION pooler (port 5432), not the transaction pooler (6543):
# Flyway takes a session-level advisory lock while migrating, and Hibernate
# uses server-side prepared statements. Both misbehave behind a transaction pooler.
#
#   Host from the dashboard, e.g. aws-0-ap-south-1.pooler.supabase.com
#   User is "postgres.<project-ref>"
DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=<your-database-password>
